    {
      "id": "scale-foundation-scale",
      "topic": "音階",
      "prompt": "音を一定の音程の並びに従って、高さの順に並べた音列を（　）という。",
      "answer": "音階",
      "explanation": "音階にはさまざまな種類があります。このセットでは長音階・短音階を扱います。",
      "concept": "scale",
      "sources": [
        "senzoku-scales",
        "ps-scales",
        "lehr-minor"
      ],
      "reviewNotes": [
        "2026-10-07ユーザー校閲案を一次教材で検討して更新。原承認文案は履歴として保持。"
      ]
    },
    {
      "id": "scale-foundation-tonic",
      "topic": "主音",
      "prompt": "長調・短調の中心となる、音階の第I音を（　）という。",
      "answer": "主音",
      "explanation": "ハ長調でもハ短調でも、主音はハです。",
      "concept": "tonic",
      "sources": [
        "senzoku-scales",
        "ps-scales",
        "lehr-minor"
      ],
      "reviewNotes": [
        "原語のカナは発音を簡略化した編集上の近似で人間校閲待ち。"
      ]
    },
    {
      "id": "scale-foundation-major-half-steps",
      "topic": "長音階",
      "prompt": "長音階では、第III–IV音間と第（　）音間が半音で、ほかの隣り合う音の間隔は全音になる。",
      "answer": "VII–I（上）",
      "explanation": "III＝中音（上中音）、IV＝下属音、VII＝導音。I（上）は1オクターブ上の主音です。",
      "concept": null,
      "sources": [
        "senzoku-scales",
        "senzoku-degrees",
        "ps-scales"
      ],
      "reviewNotes": [
        "2026-10-07ユーザー校閲案を一次教材で検討して更新。原承認文案は履歴として保持。"
      ]
    },
